- framework = entity
- versions = framework.versions
- selected_version = params[:version] || framework.version

- if params[:create]
  - name = params[:name].to_s.strip
  - mode = params[:mode].to_s.strip
  - base = (params[:base] || selected_version).to_s.strip
  - prompt = params[:prompt].to_s
  - error = nil
  - if name.empty?
    - error = "Please provide a version name"
  - else
    - new_dir = framework.corpora[name]
    - if Open.exists?(new_dir)
      - error = "Version '#{name}' already exists"
    - else
      - begin
        - if mode == 'copy'
          - Open.mkdir_p new_dir
          - source = framework.corpus_for_version(base)
          - Open.rsync(source.to_s + "/", new_dir.to_s + "/")
        - elsif mode == 'empty'
          - Open.mkdir_p new_dir
        - elsif mode == 'ai'
          - Open.mkdir_p new_dir
          - job = Ethics.job(:prepare, prompt: prompt, framework: framework.to_s, endpoint: :openai)
          - files = job.run
          - if job.files_dir && Open.exists?(job.files_dir)
            - Open.rsync(job.files_dir.to_s + "/", new_dir.to_s + "/")
        - else
          - error = "Unknown mode '#{mode}'"
      - rescue => e
        - error = "Creation failed: #{e.message}"
  - if error
    .alert.alert-warning.mt-3
      span= error
  - else
    .alert.alert-success.mt-3
      span Created corpus version '#{name}'
    - selected_version = name
    - framework.set_active selected_version

- corpus = Corpus.setup([framework, selected_version] * "·")

/ Toolbar: version selector + quick actions
.flex.items-center.justify-between.mb-4
  .flex.items-center.gap-3
    span.text-sm.text-slate-500 Version:
    details.dropdown
      summary.btn.btn-sm Choose (#{selected_version})
      ul.menu.dropdown-content.bg-base-100.rounded-box.z-100.w-56.p-2.shadow
        - versions.each do |v|
          li
            a[
              hx-get=entity_url(framework, :action, :corpus_pane, _format: 'html', version: v)
              hx-target='#corpus-pane'
              _='on click remove @open from the closest <details/>'
            ]= v

  .flex.items-center.gap-2
    details.dropdown.dropdown-end
      summary.btn.btn-sm.btn-primary New corpus
      .dropdown-content.bg-base-100.rounded-box.shadow.p-4.w-96
        form.space-y-3 method="get" action=entity_url(framework, :action, :corpus_pane, _format: 'html')
          .form-control
            label.label
              span.label-text.font-medium Version name
            input.input.input-bordered.w-full type="text" name="name" placeholder="e.g. v2" required=true
          .form-control
            label.label
              span.label-text.font-medium Mode
            select.select.select-bordered.w-full name="mode"
              option value="copy" Copy from existing
              option value="empty" Empty corpus
              option value="ai" Generate with AI
          .form-control
            label.label
              span.label-text.font-medium Base version (for copy)
            select.select.select-bordered.w-full name="base"
              - versions.each do |v|
                option value=v selected=(v == selected_version) = v
          .form-control
            label.label
              span.label-text.font-medium Prompt (for AI mode)
            textarea.textarea.textarea-bordered.w-full name="prompt" rows="5" placeholder="Instructions to generate the corpus (only used if Mode=AI)"
          input type="hidden" name="create" value="1"
          .flex.justify-end.gap-2
            button.btn.btn-ghost.btn-sm type="button" _="on click remove @open from the closest <details/>" Cancel
            button.btn.btn-primary.btn-sm type="submit" Create

.card.bg-base-100.shadow
  .card-body
    .flex.items-center.justify-between.mb-2
      h3.card-title.text-lg Documents for version ‘#{selected_version}’
      .flex.items-center.gap-2
        span.badge.badge-outline.text-xs= "Active: #{framework.version}"
        - if framework.version != selected_version
          button.btn.btn-xs[
            hx-get=entity_url(framework, :property, :set_active, args: [selected_version].to_json, _format: 'json')
            hx-swap='none'
            hx-on='htmx:afterRequest: htmx.ajax("GET", "#{entity_url(framework, :action, :corpus_pane, _format: 'html', version: selected_version)}", {target: "#corpus-pane"})'
          ] Set active

    / Files list and controls
    #files
      == render_entity_partial corpus, :action, :files

