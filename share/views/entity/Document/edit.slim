- doc = entity

h2.text-xl.font-semibold.mb-3 Edit document
p.text-sm.text-slate-500.mb-4= doc.path
.divider

.form-control
  textarea#markdown-editor.textarea.textarea-bordered.w-full.h-96 data-markdown-editor="true" = doc.content

.flex.justify-end.gap-2.mt-4
  a.btn.btn-ghost href=entity_url(doc) Cancel
  button#save-button.btn.btn-primary Save

javascript:
  (function(){
    var btn = document.getElementById("save-button");
    var ta = document.getElementById("markdown-editor");
    if (!btn || !ta) return;
    btn.addEventListener("click", function(){
      var content = (ta._easymde ? ta._easymde.value() : ta.value);
      fetch("/save_document?_format=json", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ content: content, document: "#{doc}" })
      })
      .then(function(r){ if(!r.ok) throw new Error("Save failed"); return r.json(); })
      .then(function(){
      })
      .catch(function(e){ alert(e.message); });
    });
  })();

