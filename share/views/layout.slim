- title = "Ethics AI Agent"
doctype html
html.h-full.bg-slate-50 lang="en" data-theme="light"
  base href=script_name
  head
    meta charset="utf-8"
    meta name="viewport" content="width=device-width, initial-scale=1.0"
    meta name="csrf-token" content=csrf_token
    meta name="script_name" content=script_name
    meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests"

    title = title

    link rel="preconnect" href="https://fonts.googleapis.com"
    link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"
    /link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"


    script src="https://cdn.jsdelivr.net/npm/@tailwindplus/elements@1" type="module"
    == link_js "/plugins/hyperscript/hyperscript.js"

    - record_css "/css/app.css"

    - record_js "/plugins/htmx/htmx.js"
    - record_js "/plugins/htmx/sse.js"
    - record_js "/plugins/easymde/easymde.min.js"
    - record_css "/plugins/easymde/easymde.min.css"

    - record_js "/js/app.js"

    == serve_css

  body.flex.min-h-screen.flex-col.bg-base-100.text-base-content
    == render_partial 'partial/header', title: title

    main.flex-1.mx-auto.px-4.sm:px-6.lg:px-8.mt-8.container
      == yield

    footer.footer.p-10.bg-base-200.text-base-content.mt-10
      aside
        - if ScoutRender.exists?('public/logo.svg')
          img.h-8.w-auto src="/public/logo.svg" alt=""
        p
          | © #{Time.now.year} #{title}

    == serve_js

