- # New Slim-based wait fragment with HTMX polling
- # Expects `step` (job/step-like object) to be available in the template scope.
- # Uses request.fullpath (when available) to poll the same endpoint adding `_update=wait`.
- # The fragment self-updates every few seconds until the server returns a different view.
- 
- begin
  - fullpath = (defined?(fullpath) && fullpath) || (request && request.fullpath) || "/"
- rescue
  - fullpath = "/"

- update_url = add_GET_param fullpath, :_step, step.name
- update_url = remove_GET_param update_url, :_update

#wait-fragment[ hx-get=update_url hx-trigger="done" hx-swap="outerHTML" ]
  #reloader[ hx-get=update_url hx-trigger="every 1s" hx-swap="none" ]
    - workflow = step.workflow
    - task_name = step.task_name
    - name = step.name

    - if entity_type
      h3.text-l.font-semibold.mb-1 Waiting on #{[entity_type, entity, (entity_action || entity_property)].compact * " "}
    - elsif task_name
      h3.text-l.font-semibold.mb-1 Waiting on #{[workflow, task_name].compact * " "}
    - else
      h3.text-l.font-semibold.mb-1 Waiting

    - if step.status
      p.text-sm.text-slate-500.mt-0 
        Status
        span.font-medium.ml-2= step.status
