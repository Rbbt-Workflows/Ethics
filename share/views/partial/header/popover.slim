- title ||= "Menu"
- footers ||= {}
- nav ||= {}
- id = Misc.digest([title, nav, footers])

button.flex.items-center.gap-x-1.text-sm/6.font-semibold.text-gray-900 popovertarget=id
  = title
  svg.size-5.flex-none.text-gray-400 viewBox="0 0 20 20" fill="currentColor" data-slot="icon" aria-hidden="true"
    path fill-rule="evenodd" clip-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"
el-popover.w-screen.max-w-md.overflow-hidden.rounded-3xl.bg-white.shadow-lg.outline-1.outline-gray-900/5.transition.transition-discrete.backdrop:bg-transparent.open:block.data-closed:translate-y-1.data-closed:opacity-0.data-enter:duration-200.data-enter:ease-out.data-leave:duration-150.data-leave:ease-in anchor="bottom" popover="" id=id
  .p-4
    - nav.each do |item,url|
      - if item.include?(":")
        - item, description = item.split(':')
      - else
        - description = nil
      .group.relative.flex.items-center.gap-x-6.rounded-lg.p-4.text-sm/6.hover:bg-gray-50
        - if ScoutRender.exists?("public/nav_#{item}.svg")
          .flex.size-11.flex-none.items-center.justify-center.rounded-lg.bg-gray-50.group-hover:bg-white
            img.h-8.w-auto src="/public/nav_#{item}.svg" alt=""
        .flex-auto
          a.block.font-semibold.text-gray-900 href=url
            = item
            span.absolute.inset-0
          - if description
            p.mt-1.text-gray-600 = description
  .grid.grid-cols-3.divide-x.divide-gray-900/5.bg-gray-50
    - footers.each do |item,url|
      a.flex.items-center.justify-center.gap-x-2.5.p-3.text-sm/6.font-semibold.text-gray-900.hover:bg-gray-100 href=url
        - if ScoutRender.exists?("public/nav_#{item}.svg")
          img.size-5.flex-none.text-gray-400 src="/public/nav_#{item}.svg" alt=""
        = item
