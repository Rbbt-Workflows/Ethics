- require 'uri'
- jobs = (defined?(Ethics) && Ethics.respond_to?(:task_jobs)) ? Ethics.task_jobs(:evaluate) : []
- jobs = Array(jobs)
- jobs = jobs.sort_by do |j|
    - t = (j.respond_to?(:start_time) && j.start_time) || (j.respond_to?(:mtime) && j.mtime) || (j.respond_to?(:created_at) && j.created_at) rescue nil
    - t ? -t.to_i : 0
- # Group jobs by framework/version where possible
- grouped = {}
- jobs.each do |job|
  - inputs = (job.respond_to?(:inputs) && job.inputs) ? job.inputs.to_hash  : {}
  - fw = (inputs && (inputs[:framework] || inputs['framework'])) || "unknown"
  - ver = (inputs && (inputs[:version] || inputs['version'])) || "unknown"
  - grouped[fw] ||= {}
  - grouped[fw][ver] ||= []
  - grouped[fw][ver] << [job, inputs]

.h1.text-2xl.font-semibold.mb-4 Evaluation runs

.card.bg-base-100.shadow
  .card-body
    p.text-sm.text-slate-500.mb-4 Manage and inspect past and running evaluation jobs. Use the panel on the right to examine job metadata and results.

    .grid.grid-cols-1.lg:grid-cols-3.gap-6
      .col-span-2
        - if jobs.empty?
          .p-6.text-slate-500 No runs found.
        - else
          - grouped.keys.sort.each do |fw|
            - versions = grouped[fw]
            .mb-6
              h3.text-lg.font-medium.mb-2= fw
              - versions.keys.sort.each do |ver|
                - items = versions[ver]
                .mb-4
                  .flex.items-center.justify-between.gap-2.mb-2
                    span.font-medium= "Version: #{ver}"
                    span.text-xs.text-slate-500= "#{items.length} job#{'s' if items.length > 1}"
                  ul.divide-y.divide-slate-200.rounded-md.border.border-slate-200.bg-white
                    - items.each do |job, inputs|
                      - status = job.respond_to?(:status) ? job.status.to_s : (job.respond_to?(:state) ? job.state.to_s : "unknown")
                      - started = (job.respond_to?(:start_time) && job.start_time) || (job.respond_to?(:mtime) && job.mtime) || nil
                      - when_text = started ? Time.at(started.to_i).strftime("%Y-%m-%d %H:%M:%S") : "—"
                      - uc_text = (inputs && (inputs[:use_case] || inputs['use_case'])) || ""
                      - uc_short = uc_text.to_s[0,180]
                      li.p-3.flex.items-start.justify-between.gap-4
                        .flex.flex-col.gap-2
                          .flex.items-center.gap-3
                            - case status
                            - when 'done'
                              span.badge.badge-success.text-xs Done
                            - when 'error'
                              span.badge.badge-error.text-xs Error
                            - when 'running'
                              span.badge.badge-warning.text-xs Running
                            - else
                              span.badge.badge-ghost.text-xs= status.capitalize
                            strong.text-sm.ml-1= File.basename(job.path.to_s)
                            span.text-xs.text-slate-500.ml-2= when_text
                          - if uc_short && !uc_short.empty?
                            p.text-sm.text-slate-600= uc_short
                        .flex.items-center.gap-2
                          - encoded = URI.encode_www_form_component(job.path.to_s)
                          a.btn.btn-xs.btn-ghost[
                            href="/runs/view?job=#{encoded}"
                            hx-get="/runs/view?job=#{encoded}"
                            hx-target="#run-info"
                            hx-swap="innerHTML"
                          ] View
                          /a.btn.btn-xs.btn-outline[
                            href="/runs/info?job=#{encoded}"
                            hx-get="/runs/info?job=#{encoded}"
                            hx-target="#run-info"
                            hx-swap="innerHTML"
                          /] Metadata
                          /- if job.respond_to?(:files_dir) && job.files_dir
                            - fd = job.files_dir rescue nil
                          /- if fd && Open.exists?(fd)
                            a.btn.btn-xs[
                              href=job.files_dir.to_s
                              target='_blank'
                            ] Files
                          button.btn.btn-xs.btn-error[
                            hx-delete="/runs/clean?job=#{encoded}"
                            hx-swap="none"
                            hx-confirm="Delete produced files for this job?"
                            hx-on="htmx:afterRequest: htmx.ajax('GET', '/main/runs', {target:'#runs-list'})"
                          ] Clean

      / Right pane with job details; will be populated by HTMX requests
      .col-span-1
        #run-info.bg-white.rounded-md.border.border-slate-200.p-4
          h4.text-sm.font-medium.mb-2 Job details
          p.text-xs.text-slate-500 Select a job to inspect metadata or results.

